{
  "name": "skillx",
  "version": "0.1.0",
  "description": "CLI to install, manage and publish skills for AI coding assistants (Claude Code + Codex)",
  "type": "module",
  "bin": {
    "skillx": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "skills",
    "claude-code",
    "codex",
    "ai-coding",
    "skillx"
  ],
  "author": "allan",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "octokit": "^4.1.2",
    "yaml": "^2.7.1",
    "tar": "^7.4.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.14",
    "@types/tar": "^6.1.13",
    "typescript": "^5.9.3"
  }
}
